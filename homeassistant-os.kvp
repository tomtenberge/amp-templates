Meta.DisplayName=Home Assistant OS (QEMU, experimental)
Meta.Description=Home Assistant OS virtual machine managed by AMP on an Ubuntu x86_64 host. Manual first-time disk preparation required.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=Local
Meta.URL=https://www.home-assistant.io/installation/linux
Meta.DisplayImageSource=none:
Meta.EndpointURIFormat=http://{0}
Meta.ConfigManifest=homeassistant-osconfig.json
Meta.MetaConfigManifest=homeassistant-osmetaconfig.json
Meta.ConfigRoot=homeassistant-os.kvp
Meta.MinAMPVersion=2.8.0.0
Meta.DockerRequired=False
Meta.ContainerPolicy=NotSupported
Meta.ContainerPolicyReason=This initial profile launches host QEMU with host KVM access. Do not deploy this instance in an AMP container.
Meta.ConfigVersion=1
Meta.AppConfigId=1290976b-cbe5-448a-b0d4-39d74aad50a1
Meta.ImportableExtensions=[]
App.DisplayName=Home Assistant OS VM
App.RootDir=./haos/
App.BaseDirectory=./haos/
App.ExecutableLinux=/usr/bin/qemu-system-x86_64
App.WorkingDir=.
App.CommandLineArgs=-name amp-haos -machine q35,accel=kvm -cpu host -smp {{VCPUs}} -m {{MemoryMiB}} -drive if=pflash,format=raw,unit=0,readonly=on,file=OVMF_CODE.fd -drive if=pflash,format=raw,unit=1,file=OVMF_VARS.fd -device virtio-scsi-pci,id=scsi0 -drive if=none,id=haosdisk,format=qcow2,file=haos.qcow2 -device scsi-hd,drive=haosdisk,bus=scsi0.0,bootindex=1 -nic user,model=virtio-net-pci,hostfwd=tcp:{{$ApplicationIPBinding}}:{{$WebPort}}-:8123 -display none -monitor stdio -serial file:serial.log
App.AppSettings={"VCPUs":"2","MemoryMiB":"4096"}
App.EnvironmentVariables={}
App.UseLinuxIOREDIR=False
App.ExitMethod=String
App.ExitString=system_powerdown
App.ExitTimeout=180
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.Ports=@IncludeJson[homeassistant-osports.json]
App.PrimaryApplicationPortRef=WebPort
App.AdminPortRef=0
App.ApplicationIPBinding=0.0.0.0
App.ForceIPBinding=False
App.SupportsIPv6=False
App.SupportsLiveSettingsChanges=False
App.UpdateSources=@IncludeJson[homeassistant-osupdates.json]
App.PreStartStages=@IncludeJson[homeassistant-osstart.json]
App.ForceUpdate=False
App.Compatibility=None
App.RapidStartup=False
App.ApplicationReadyMode=RegexMatch
App.SupportsUniversalSleep=False
App.SmartExcludeSupported=False
Console.AppReadyRegex=^QEMU .+ monitor - type 'help' for more information.*$
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
