Meta.DisplayName=Yoda LLM (llama.cpp CPU)
Meta.Description=CPU LLM API for chat rewriting, managed in Docker.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=Merte
Meta.URL=https://github.com/ggml-org/llama.cpp
Meta.DisplayImageSource=url:https://github.com/ggml-org.png
Meta.EndpointURIFormat=http://{0}
Meta.ConfigManifest=yoda-llmconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=yoda-llm.kvp
Meta.MinAMPVersion=2.4.5.4
Meta.DockerRequired=True
Meta.ContainerPolicy=RequiredOnLinux
Meta.ContainerPolicyReason=This template is configured for an AMP-managed Linux container.
Meta.ExtraContainerPackages=["libgomp1"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=3
Meta.AppConfigId=078eb2be-7193-45ee-a9ad-e7c76245ae20

App.DisplayName=Yoda LLM
App.RootDir=./yoda-llm/
App.BaseDirectory=./yoda-llm/serverfiles/
App.ExecutableLinux=serverfiles/llama-server
App.WorkingDir=serverfiles
App.CommandLineArgs=--hf-repo "{{Model}}" --alias yoda --host 0.0.0.0 --port {{$ServerPort}} --threads {{Threads}} --threads-batch {{BatchThreads}} --ctx-size {{Context}} --parallel 1 --n-gpu-layers 0 --jinja --api-key-file api-key.txt
App.AppSettings={"Model":"Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M","Threads":"12","BatchThreads":"12","Context":"4096"}
App.EnvironmentVariables={"LLAMA_CACHE":"./cache"}
App.ApplicationIPBinding=0.0.0.0
App.Ports=[{"Protocol":"TCP","Port":8089,"Ref":"ServerPort","Name":"LLM HTTP API","Description":"HTTP API for chat completions and health checks"}]
App.PrimaryApplicationPortRef=ServerPort
App.AdminPortRef=0
App.AdminMethod=STDIO
App.HasReadableConsole=True
App.HasWriteableConsole=False
App.ExitMethod=SIGTERM
App.ExitTimeout=60
App.RapidStartup=False
App.MonitorChildProcess=False
App.SupportsLiveSettingsChanges=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
App.UpdateSources=@IncludeJson[yoda-llmupdates.json]

Console.AppReadyRegex=^.*listening on http://.*$
Console.SuppressLogAtStart=False

Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
