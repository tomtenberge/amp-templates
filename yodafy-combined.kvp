Meta.DisplayName=Yodafy Combined (LLM + API)
Meta.Description=Yoda chat filter and CPU model in one AMP-managed container.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=Merte
Meta.URL=https://github.com/tomtenberge/amp-templates
Meta.DisplayImageSource=url:https://github.com/ggml-org.png
Meta.EndpointURIFormat=http://{0}/health
Meta.ConfigManifest=yodafy-combinedconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=yodafy-combined.kvp
Meta.MinAMPVersion=2.4.5.4
Meta.DockerRequired=True
Meta.ContainerPolicy=RequiredOnLinux
Meta.ExtraContainerPackages=["python3","libgomp1"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.AppConfigId=2b08e4b3-e0e6-4830-833a-f3f1d4ca6384
App.DisplayName=Yodafy Combined
App.RootDir=./yodafy-combined/
App.BaseDirectory=./yodafy-combined/serverfiles/
App.ExecutableLinux=/usr/bin/python3
App.WorkingDir=serverfiles
App.CommandLineArgs=-u yodafy_server.py --port {{$ServerPort}} --model "{{Model}}" --threads {{Threads}} --context {{Context}} --timeout {{Timeout}}
App.AppSettings={"Model":"Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M","Threads":"12","Context":"4096","Timeout":"15"}
App.ApplicationIPBinding=0.0.0.0
App.Ports=[{"Protocol":"TCP","Port":8091,"Ref":"ServerPort","Name":"Yodafy HTTP API","Description":"Public filter endpoint; internal model port 8089 is not published"}]
App.PrimaryApplicationPortRef=ServerPort
App.AdminPortRef=0
App.AdminMethod=STDIO
App.HasReadableConsole=True
App.HasWriteableConsole=False
App.ExitMethod=SIGTERM
App.ExitTimeout=30
App.MonitorChildProcess=False
App.RapidStartup=False
App.SupportsLiveSettingsChanges=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
App.UpdateSources=@IncludeJson[yodafy-combinedupdates.json]
Console.AppReadyRegex=^YODAFY READY$
Console.SuppressLogAtStart=False
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
